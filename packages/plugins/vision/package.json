{
  "name": "workdsh-plugin-vision",
  "version": "0.1.0-alpha.1",
  "private": false,
  "type": "module",
  "description": "Optional vision enhancement for text-only models in Praxis (transcribe images via a vision model)",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.browser.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "THIRD-PARTY-NOTICES.md",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../../scripts/build-vision.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.3",
    "dsh-vision-plugin": "1.4.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.3",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.7-alpha.1",
    "react": "19.2.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.3",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.7-alpha.1",
    "@types/node": "22.19.0",
    "@types/react": "19.2.14",
    "react": "19.2.4"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  }
}
